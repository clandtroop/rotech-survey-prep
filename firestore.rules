rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Follow-up checklists — looked up by unguessable visit ID. Location
    // managers open and check these off with no login (read/update must stay
    // open), but only a signed-in specialist can create a new one.
    match /followUpChecklists/{visitId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['meta', 'categories', 'notes', 'createdAt'])
                    && request.resource.data.notes is string;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['categories', 'notes', 'updatedAt']);
      allow delete: if false;
    }

    // Company-wide visit trend records — one document per finalized visit.
    // Internal data: any signed-in specialist can read/write/delete their own
    // and others' visit docs (matches how TrendTracker already merges everyone's
    // finalized visits), but no one outside the app can touch it anymore.
    match /visitTrends/{visitId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                             && request.resource.data.keys().hasAll(['visitId', 'records', 'finalizedAt'])
                             && request.resource.data.records is list
                             && request.resource.data.visitId is string;
      allow delete: if request.auth != null;
    }

    // Company-wide location roster, edited via the in-app Location Roster tab.
    match /locations/{lawson} {
      allow read, write: if request.auth != null;
    }

    // Append-only audit trail of locations writes (who changed/deleted what,
    // with full before/after content) — added after an incident where the
    // whole roster was found deleted with no record of who or when.
    match /auditLog/{entryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['collection', 'docId', 'action', 'user', 'at']);
      allow update, delete: if false;
    }

    // Lock down everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
