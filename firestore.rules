rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Follow-up checklists — looked up by unguessable visit ID, no auth required.
    match /followUpChecklists/{visitId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['meta', 'categories', 'notes', 'createdAt'])
                    && request.resource.data.notes is string;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['categories', 'notes', 'updatedAt']);
      allow delete: if false;
    }

    // Company-wide visit trend records — one document per finalized visit.
    // Any specialist can write/overwrite their own visit doc and read all docs.
    match /visitTrends/{visitId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['visitId', 'records', 'finalizedAt'])
                             && request.resource.data.records is list
                             && request.resource.data.visitId is string;
      allow delete: if true;
    }

    // Lock down everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
